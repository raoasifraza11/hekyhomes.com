---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { getReadingTime, formatReadingTime } from '../utils/readingTime';

type Props = CollectionEntry<'blog'>['data'] & {
	readingTime?: number;
};

const { title, description, pubDate, updatedDate, heroImage, tags, category, author, readingTime } = Astro.props;
const currentUrl = Astro.url.pathname;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.post-meta {
				display: flex;
				gap: 1em;
				align-items: center;
				justify-content: center;
				flex-wrap: wrap;
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.meta-item {
				display: flex;
				align-items: center;
				gap: 0.3em;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.category {
				display: inline-block;
				background: rgb(var(--accent));
				color: white;
				padding: 0.25em 0.75em;
				border-radius: 20px;
				font-size: 0.85em;
				font-weight: 600;
				text-decoration: none;
				margin-bottom: 1em;
			}
			.tags {
				display: flex;
				gap: 0.5em;
				flex-wrap: wrap;
				margin: 2em 0;
				padding-top: 2em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.tag {
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				padding: 0.25em 0.75em;
				border-radius: 4px;
				font-size: 0.85em;
				text-decoration: none;
				transition: background 0.2s;
			}
			.tag:hover {
				background: rgb(var(--gray));
				color: white;
			}
			.author-section {
				margin-top: 3em;
				padding: 1.5em;
				background: rgb(var(--gray-light));
				border-radius: 8px;
				border-left: 4px solid rgb(var(--accent));
			}
			.author-name {
				font-weight: 600;
				color: rgb(var(--gray-dark));
				margin-bottom: 0.25em;
			}
			.reading-time {
				font-weight: 500;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						{category && (
							<div style="text-align: center; margin-bottom: 1em;">
								<a href={`/blog/category/${category.toLowerCase().replace(/\s+/g, '-')}`} class="category">
									{category}
								</a>
							</div>
						)}
						<h1>{title}</h1>
						<div class="post-meta">
							<div class="meta-item">
								<span>📅</span>
								<FormattedDate date={pubDate} />
							</div>
							{author && (
								<div class="meta-item">
									<span>✍️</span>
									<span>{author}</span>
								</div>
							)}
							{readingTime && (
								<div class="meta-item reading-time">
									<span>⏱️</span>
									<span>{formatReadingTime(readingTime)}</span>
								</div>
							)}
						</div>
						{
							updatedDate && (
								<div class="last-updated-on" style="text-align: center; margin-top: 0.5em;">
									Last updated on <FormattedDate date={updatedDate} />
								</div>
							)
						}
						<hr />
					</div>
					<slot />
					
					<ShareButtons title={title} url={currentUrl} />
					
					{tags && tags.length > 0 && (
						<div class="tags">
							<span style="font-weight: 600; color: rgb(var(--gray));">Tags:</span>
							{tags.map((tag: string) => (
								<a href={`/blog/tag/${tag.toLowerCase().replace(/\s+/g, '-')}`} class="tag">
									#{tag}
								</a>
							))}
						</div>
					)}
					{author && (
						<div class="author-section">
							<div class="author-name">Written by {author}</div>
							<div style="color: rgb(var(--gray)); font-size: 0.9em;">
								Sharing insights and stories about creating beautiful homes and meaningful living spaces.
							</div>
						</div>
					)}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
