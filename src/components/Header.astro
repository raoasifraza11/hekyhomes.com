		<h2><a href="/" class="logo-link" aria-label="HEKYHomes Home"><Logo /></a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blogs</HeaderLink>
			<div class="dropdown">
				<a href="#" class="dropdown-trigger">
					Categories
					<span class="arrow">▼</span>
				</a>
				<div class="dropdown-menu">
					<div class="dropdown-columns">
						<div class="dropdown-column">
							<div class="column-title">Home Spaces</div>
							<a href="/blog/category/kitchen" class="dropdown-item">Kitchen</a>
							<a href="/blog/category/bathrooms" class="dropdown-item">Bathrooms</a>
							<a href="/blog/category/interior-design" class="dropdown-item">Interior Design</a>
							<a href="/blog/category/furniture" class="dropdown-item">Furniture</a>
						</div>
						<div class="dropdown-column">
							<div class="column-title">Home Care</div>
							<a href="/blog/category/home-improvement" class="dropdown-item">Home Improvement</a>
							<a href="/blog/category/windows" class="dropdown-item">Windows</a>
							<a href="/blog/category/pests" class="dropdown-item">Pests</a>
						</div>
						<div class="dropdown-column">
							<div class="column-title">Outdoor & More</div>
							<a href="/blog/category/garden" class="dropdown-item">Garden</a>
							<a href="/blog/category/property" class="dropdown-item">Property</a>
							<a href="/blog/category/tv" class="dropdown-item">TV & Entertainment</a>
						</div>
					</div>
				</div>
			</div>
			<HeaderLink href="/contact">Contact US</HeaderLink>
			<HeaderLink href="/about">About US</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://twitter.com/hekyhomes" target="_blank">
				<span class="sr-only">Follow HEKYHomes on Twitter</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
