---
// HEKYHomes Logo Component
---

<svg class="logo" viewBox="0 0 200 50" xmlns="http://www.w3.org/2000/svg">
	<!-- House Icon -->
	<g class="house-icon">
		<!-- Roof -->
		<path d="M 15 20 L 25 12 L 35 20 Z" fill="currentColor"/>
		<!-- House Body -->
		<rect x="17" y="20" width="16" height="14" fill="currentColor"/>
		<!-- Door -->
		<rect x="22" y="26" width="6" height="8" fill="white"/>
		<!-- Window -->
		<rect x="19" y="22" width="4" height="4" fill="white" opacity="0.9"/>
		<rect x="27" y="22" width="4" height="4" fill="white" opacity="0.9"/>
		<!-- Chimney -->
		<rect x="30" y="14" width="2" height="6" fill="currentColor"/>
	</g>
	
	<!-- HEKY Text -->
	<text x="45" y="28" font-family="'Atkinson', sans-serif" font-weight="700" font-size="24" fill="currentColor" class="brand-text">
		HEKY
	</text>
	
	<!-- Homes Text -->
	<text x="45" y="38" font-family="'Atkinson', sans-serif" font-weight="400" font-size="12" fill="currentColor" opacity="0.8" class="sub-text">
		Homes
	</text>
</svg>

<style>
	.logo {
		height: 40px;
		width: auto;
		color: rgb(var(--black));
		transition: transform 0.3s ease;
	}
	
	.logo:hover {
		transform: scale(1.05);
	}
	
	.house-icon {
		animation: subtle-bounce 3s ease-in-out infinite;
	}
	
	@keyframes subtle-bounce {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-2px); }
	}
	
	@media (prefers-reduced-motion: reduce) {
		.house-icon {
			animation: none;
		}
		.logo:hover {
			transform: none;
		}
	}
</style>

