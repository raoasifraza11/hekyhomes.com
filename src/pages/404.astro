---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`404 - Page Not Found | ${SITE_TITLE}`} description="Oops! The page you're looking for doesn't exist." />
		<style>
			main {
				width: 960px;
			}
			.error-container {
				text-align: center;
				padding: 4em 2em;
				min-height: 60vh;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
			}
			.error-code {
				font-size: 10em;
				font-weight: 900;
				color: rgb(var(--accent));
				margin: 0;
				line-height: 1;
				text-shadow: 0 4px 8px rgba(0,0,0,0.1);
			}
			.error-title {
				font-size: 2.5em;
				margin: 0.5em 0;
				color: rgb(var(--black));
			}
			.error-message {
				font-size: 1.2em;
				color: rgb(var(--gray));
				max-width: 600px;
				margin: 1em auto 2em;
				line-height: 1.6;
			}
			.error-links {
				display: flex;
				gap: 1em;
				flex-wrap: wrap;
				justify-content: center;
				margin-top: 2em;
			}
			.error-link {
				display: inline-block;
				padding: 1em 2em;
				background: rgb(var(--accent));
				color: white;
				text-decoration: none;
				border-radius: 8px;
				font-weight: 600;
				transition: transform 0.2s, box-shadow 0.2s;
			}
			.error-link:hover {
				transform: translateY(-2px);
				box-shadow: 0 5px 15px rgba(var(--accent), 0.4);
			}
			.error-link.secondary {
				background: white;
				color: rgb(var(--accent));
				border: 2px solid rgb(var(--accent));
			}
			.error-link.secondary:hover {
				background: rgb(var(--accent-light));
			}
			.suggestions {
				margin-top: 3em;
				padding: 2em;
				background: rgb(var(--gray-light));
				border-radius: 12px;
				max-width: 600px;
			}
			.suggestions h3 {
				margin-top: 0;
				color: rgb(var(--black));
			}
			.suggestions ul {
				text-align: left;
				line-height: 2;
			}
			.suggestions a {
				color: rgb(var(--accent));
				text-decoration: none;
				font-weight: 600;
			}
			.suggestions a:hover {
				text-decoration: underline;
			}
			.icon {
				font-size: 5em;
				margin-bottom: 0.5em;
			}
			@media (max-width: 720px) {
				.error-code {
					font-size: 6em;
				}
				.error-title {
					font-size: 1.8em;
				}
				.error-links {
					flex-direction: column;
					width: 100%;
				}
				.error-link {
					width: 100%;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="error-container">
				<div class="icon">🏠❓</div>
				<h1 class="error-code">404</h1>
				<h2 class="error-title">Page Not Found</h2>
				<p class="error-message">
					Oops! Looks like this page has moved to a new home, or maybe it never existed. 
					Don't worry, we'll help you find your way!
				</p>

				<div class="error-links">
					<a href="/" class="error-link">🏠 Go Home</a>
					<a href="/blog" class="error-link secondary">📝 Browse Blog</a>
				</div>

				<div class="suggestions">
					<h3>🔍 Looking for something?</h3>
					<ul>
						<li><a href="/">Homepage</a> - Start fresh</li>
						<li><a href="/blog">Blog</a> - All our posts</li>
						<li><a href="/categories">Categories</a> - Browse by topic</li>
						<li><a href="/about">About</a> - Learn about us</li>
					</ul>
					<p style="margin-top: 1.5em; color: rgb(var(--gray)); font-size: 0.9em;">
						If you think this is an error, please <a href="mailto:hello@hekyhomes.com">let us know</a>!
					</p>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>


