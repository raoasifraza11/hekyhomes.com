---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const allPosts = await getCollection('blog');
const publishedPosts = allPosts.filter(post => !post.data.draft);

// Get all categories with post counts
const categoryMap = new Map();
publishedPosts.forEach(post => {
	if (post.data.category) {
		const count = categoryMap.get(post.data.category) || 0;
		categoryMap.set(post.data.category, count + 1);
	}
});

const categories = Array.from(categoryMap.entries())
	.sort((a, b) => b[1] - a[1]) // Sort by count descending
	.map(([name, count]) => ({ name, count }));

const title = `Categories - ${SITE_TITLE}`;
const description = 'Browse all blog post categories';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				max-width: 1400px;
				margin: 0 auto;
				padding: 2em 3em;
			}
			.page-header {
				text-align: center;
				margin: 1em 0 2em;
			}
			.page-header h1 {
				font-size: 2em;
				margin-bottom: 0.3em;
			}
			.page-header p {
				color: rgb(var(--gray));
				font-size: 1em;
			}
			.categories-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
				gap: 1em;
				margin: 2em 0;
			}
			.category-card {
				background: white;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				padding: 1.5em;
				text-align: center;
				text-decoration: none;
				transition: all 0.2s ease;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
			}
			.category-card:hover {
				transform: translateY(-3px);
				box-shadow: 0 3px 12px rgba(0,0,0,0.1);
				border-color: rgb(var(--accent));
			}
			.category-icon {
				font-size: 2.5em;
				margin-bottom: 0.4em;
			}
			.category-name {
				font-size: 1.2em;
				font-weight: 700;
				color: rgb(var(--black));
				margin-bottom: 0.2em;
			}
			.category-count {
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.back-link {
				display: inline-block;
				margin: 2em 0;
				color: rgb(var(--accent));
				text-decoration: none;
				font-weight: 600;
			}
			.back-link:hover {
				text-decoration: underline;
			}
			@media (max-width: 768px) {
				main {
					padding: 1em;
				}
				.categories-grid {
					grid-template-columns: repeat(2, 1fr);
				}
			}
			@media (max-width: 480px) {
				.categories-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>Categories</h1>
				<p>Browse posts by category</p>
			</div>

			{categories.length > 0 ? (
				<div class="categories-grid">
					{categories.map((category) => {
						const slug = category.name.toLowerCase().replace(/\s+/g, '-');
						const icon = 
							category.name === 'Interior Design' ? '🎨' :
							category.name === 'Home Improvement' ? '🔨' :
							category.name === 'Property' ? '🏠' :
							category.name === 'Windows' ? '🪟' :
							category.name === 'Furniture' ? '🛋️' :
							category.name === 'TV' ? '📺' :
							category.name === 'Kitchen' ? '🍳' :
							category.name === 'Bathrooms' ? '🚿' :
							category.name === 'Garden' ? '🌿' :
							category.name === 'Pests' ? '🐛' :
							'📝';
						
						return (
							<a href={`/blog/category/${slug}`} class="category-card">
								<div class="category-icon">{icon}</div>
								<div class="category-name">{category.name}</div>
								<div class="category-count">
									{category.count} {category.count === 1 ? 'post' : 'posts'}
								</div>
							</a>
						);
					})}
				</div>
			) : (
				<p style="text-align: center; color: rgb(var(--gray)); margin: 3em 0;">
					No categories found.
				</p>
			)}
		</main>
		<Footer />
	</body>
</html>


