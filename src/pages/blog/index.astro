---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getReadingTime, formatReadingTime } from '../../utils/readingTime';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Filter out draft posts
const posts = allPosts.filter(post => !post.data.draft);

// Pagination
const postsPerPage = 9;
const currentPage = 1; // For now, we'll implement full pagination later
const totalPages = Math.ceil(posts.length / postsPerPage);
const paginatedPosts = posts.slice(0, postsPerPage);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog - ${SITE_TITLE}`} description="Stories, insights, and updates from HEKYHomes. Explore home design, real estate tips, and lifestyle inspiration." />
		<style>
			main {
				max-width: 1400px;
				margin: 0 auto;
				padding: 2em 3em;
			}
			.page-header {
				text-align: center;
				margin: 1em 0 2em;
			}
			.page-header h1 {
				margin-bottom: 0.5em;
			}
			.page-header p {
				color: rgb(var(--gray));
				font-size: 1.1em;
			}
			ul {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.post-card {
				height: 100%;
				display: flex;
				flex-direction: column;
			}
			.post-content {
				flex: 1;
				display: flex;
				flex-direction: column;
			}
			.title {
				margin: 0.5em 0;
				color: rgb(var(--black));
				line-height: 1.3;
			}
			.description {
				color: rgb(var(--gray-dark));
				margin: 0.5em 0;
				font-size: 0.95em;
				flex: 1;
			}
			.post-meta {
				display: flex;
				gap: 1em;
				align-items: center;
				margin-top: 0.75em;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.meta-item {
				display: flex;
				align-items: center;
				gap: 0.3em;
			}
			.category-badge {
				display: inline-block;
				background: rgb(var(--accent));
				color: white;
				padding: 0.25em 0.75em;
				border-radius: 20px;
				font-size: 0.8em;
				font-weight: 600;
				margin-bottom: 0.5em;
			}
			.tags {
				display: flex;
				gap: 0.5em;
				flex-wrap: wrap;
				margin-top: 0.75em;
			}
			.tag {
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				padding: 0.2em 0.6em;
				border-radius: 4px;
				font-size: 0.8em;
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			
			.pagination {
				display: flex;
				justify-content: center;
				gap: 0.5em;
				margin-top: 3em;
				padding: 2em 0;
			}
			.pagination a,
			.pagination span {
				padding: 0.75em 1.25em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 6px;
				text-decoration: none;
				color: rgb(var(--black));
				font-weight: 600;
				transition: all 0.3s ease;
			}
			.pagination a:hover {
				background: rgb(var(--accent));
				color: white;
				border-color: rgb(var(--accent));
			}
			.pagination span.current {
				background: rgb(var(--accent));
				color: white;
				border-color: rgb(var(--accent));
			}
			.pagination span.disabled {
				opacity: 0.5;
				cursor: not-allowed;
			}
			
			@media (max-width: 1200px) {
				ul {
					grid-template-columns: repeat(2, 1fr);
				}
			}
			@media (max-width: 720px) {
				main {
					padding: 1em;
				}
				ul {
					grid-template-columns: 1fr;
					gap: 1.5em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<div class="page-header">
					<h1>Blog</h1>
					<p>Stories, insights, and updates from HEKYHomes</p>
				</div>
				<ul>
					{
						paginatedPosts.map((post) => {
							const readingTime = getReadingTime(post.body);
							return (
								<li>
									<a href={`/blog/${post.id}/`} class="post-card">
										{post.data.heroImage && (
											<Image width={720} height={360} src={post.data.heroImage} alt="" />
										)}
										<div class="post-content">
											{post.data.category && (
												<span class="category-badge">{post.data.category}</span>
											)}
											<h4 class="title">{post.data.title}</h4>
											<p class="description">{post.data.description}</p>
											<div class="post-meta">
												<div class="meta-item">
													<span>📅</span>
													<FormattedDate date={post.data.pubDate} />
												</div>
												<div class="meta-item">
													<span>⏱️</span>
													<span>{formatReadingTime(readingTime)}</span>
												</div>
											</div>
											{post.data.tags && post.data.tags.length > 0 && (
												<div class="tags">
													{post.data.tags.slice(0, 3).map((tag: string) => (
														<span class="tag">#{tag}</span>
													))}
												</div>
											)}
										</div>
									</a>
								</li>
							);
						})
					}
				</ul>
				
				{totalPages > 1 && (
					<div class="pagination">
						<span class="disabled">← Previous</span>
						<span class="current">1</span>
						{Array.from({ length: totalPages - 1 }, (_, i) => i + 2).map((pageNum) => (
							<a href={`/blog/page/${pageNum}`}>{pageNum}</a>
						))}
						{totalPages > 1 && <a href="/blog/page/2">Next →</a>}
					</div>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>
