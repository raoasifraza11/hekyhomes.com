---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_EMAIL } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About - ${SITE_TITLE}`} description="Learn more about HEKYHomes and our mission to help you create beautiful living spaces." />
		<style>
			main {
				width: 960px;
			}
			.about-hero {
				text-align: center;
				padding: 3em 0;
				background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
				margin: -2em -2em 3em -2em;
				color: white;
				border-radius: 0 0 20px 20px;
			}
			.about-hero h1 {
				font-size: 3em;
				margin: 0 0 0.5em;
				color: white;
				text-shadow: 0 2px 4px rgba(0,0,0,0.2);
			}
			.about-hero p {
				font-size: 1.3em;
				max-width: 600px;
				margin: 0 auto;
				color: white;
				text-shadow: 0 1px 2px rgba(0,0,0,0.1);
			}
			.content {
				max-width: 720px;
				margin: 0 auto;
				padding: 2em;
			}
			.content h2 {
				color: rgb(var(--black));
				margin-top: 2em;
				margin-bottom: 1em;
			}
			.content p {
				line-height: 1.8;
				color: rgb(var(--gray-dark));
				margin-bottom: 1.5em;
			}
			.stats {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
				gap: 2em;
				margin: 3em 0;
			}
			.stat-card {
				text-align: center;
				padding: 2em;
				background: rgb(var(--gray-light));
				border-radius: 12px;
			}
			.stat-number {
				font-size: 3em;
				font-weight: 700;
				color: rgb(var(--accent));
				margin-bottom: 0.25em;
			}
			.stat-label {
				color: rgb(var(--gray-dark));
				font-size: 1.1em;
			}
			.contact-box {
				background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
				color: white;
				padding: 3em;
				border-radius: 12px;
				text-align: center;
				margin: 3em 0;
			}
			.contact-box h2 {
				color: white;
				margin-top: 0;
			}
			.contact-box a {
				color: white;
				text-decoration: underline;
				font-weight: 600;
			}
			.team-values {
				background: rgb(var(--gray-light));
				padding: 2em;
				border-radius: 12px;
				border-left: 4px solid rgb(var(--accent));
			}
			@media (max-width: 720px) {
				.about-hero h1 {
					font-size: 2em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="about-hero">
				<h1>About HEKYHomes</h1>
				<p>Creating beautiful homes, inspiring better living</p>
			</div>

			<div class="content">
				<h2>Who We Are</h2>
				<p>
					HEKYHomes is your trusted source for home inspiration, design tips, and real estate insights. 
					We believe that everyone deserves a space they can call home—a place that reflects their personality, 
					meets their needs, and brings them joy.
				</p>

				<p>
					Through our blog, we share practical advice, design trends, sustainability tips, and expert guides 
					to help you make informed decisions about your living space. Whether you're buying your first home, 
					renovating, decorating, or simply looking for inspiration, we're here to help.
				</p>

				<h2>Our Mission</h2>
				<p>
					To educate, inspire, and support people in creating beautiful, functional, and sustainable living 
					spaces that enhance their quality of life.
				</p>

				<div class="team-values">
					<h3>Our Values</h3>
					<ul>
						<li><strong>Education</strong> - Sharing knowledge to empower informed decisions</li>
						<li><strong>Inspiration</strong> - Showcasing possibilities and creative ideas</li>
						<li><strong>Sustainability</strong> - Promoting eco-friendly and responsible living</li>
						<li><strong>Community</strong> - Building connections among home enthusiasts</li>
						<li><strong>Authenticity</strong> - Providing honest, practical advice</li>
					</ul>
				</div>

				<h2>What We Cover</h2>
				<p>Our blog features content across several key areas:</p>
				<ul>
					<li><strong>Home Design & Trends</strong> - Latest styles, colors, and design innovations</li>
					<li><strong>Real Estate</strong> - Buying, selling, and market insights</li>
					<li><strong>DIY & Tips</strong> - Practical guides for home improvement</li>
					<li><strong>Sustainability</strong> - Eco-friendly living and green homes</li>
					<li><strong>Organization</strong> - Space optimization and storage solutions</li>
				</ul>

				<div class="stats">
					<div class="stat-card">
						<div class="stat-number">5+</div>
						<div class="stat-label">Categories</div>
					</div>
					<div class="stat-card">
						<div class="stat-number">100%</div>
						<div class="stat-label">Quality Content</div>
					</div>
					<div class="stat-card">
						<div class="stat-number">∞</div>
						<div class="stat-label">Inspiration</div>
					</div>
				</div>

				<h2>Join Our Community</h2>
				<p>
					We're building a community of home enthusiasts, designers, homeowners, and anyone who loves 
					creating beautiful spaces. Follow us on social media, share your own home stories, and let's 
					inspire each other.
				</p>

				<div class="contact-box">
					<h2>Get in Touch</h2>
					<p>Have questions, suggestions, or want to collaborate?</p>
					<p>Email us at <a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a></p>
					<p>We'd love to hear from you!</p>
				</div>

				<h2>Our Commitment</h2>
				<p>
					Every article we publish is carefully researched and written to provide genuine value. 
					We're committed to maintaining high standards of quality, accuracy, and authenticity in 
					everything we share.
				</p>

				<p>
					Thank you for being part of the HEKYHomes community. Here's to creating spaces we love! 🏠✨
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>
